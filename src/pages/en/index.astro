---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { perfil } from "../../data/site";
import { perfilEn, faixaTechEn, numerosEn, focoEn, trajetoriaEn, competenciasEn, cvEn, mensagemContatoEn, casosEn } from "../../data/site.en";
import foto from "../../assets/perfil.jpg";
import { placar, execucoesNovosV2, juiz, execucoesNovos2 } from "../../data/evals";

const placarV0 = placar("v0").texto;
const placarV1 = placar("v1").texto;
const placarV2 = placar("v2").texto;
const juizV2 = juiz("novos2", "v2");
const execNovos2V2 = execucoesNovos2.v2.map((n) => placar(n).texto).join(" · ");
const execNovosV2 = execucoesNovosV2.map((n) => placar(n).texto).join(" · ");

const cases = (await getCollection("cases", (c) => !c.data.rascunho)).sort((a, b) => a.data.ordem - b.data.ordem);
const grupos = [
  { titulo: "Companies", sub: "Hackathons", itens: cases.filter((c) => c.data.categoria === "empresa") },
  { titulo: "University", sub: "FIAP challenges", itens: cases.filter((c) => c.data.categoria === "faculdade") },
];

const mailto = `mailto:${perfil.email}?subject=${encodeURIComponent(mensagemContatoEn.assunto)}&body=${encodeURIComponent(mensagemContatoEn.corpo)}`;
---
<Base lang="en" descricao={perfilEn.posicionamento}>
  <section class="pf-hero">
    <div class="pf-container pf-hero__grid">
      <div>
        <p class="eyebrow">{perfilEn.titulo}</p>
        <h1 style="margin-top: var(--space-3)">{perfil.nome}</h1>
        <p class="lead" style="margin-top: var(--space-5)">{perfilEn.posicionamento}</p>
        <ul class="pf-lines" aria-label="Areas">
          {perfilEn.linhas.map((l) => <li>{l}</li>)}
        </ul>
        <div class="pf-actions">
          <a class="pf-btn pf-btn--primary" href="#work">View projects <Icon nome="arrow" tamanho={18} /></a>
          <a class="pf-btn pf-btn--secondary" href={cvEn.arquivo} download={cvEn.nome}><Icon nome="download" tamanho={18} /> Download CV</a>
          <a class="pf-btn pf-btn--ghost" href={mailto}><Icon nome="mail" tamanho={18} /> Get in touch</a>
        </div>
        <div class="pf-actions pf-actions--social">
          <a class="pf-iconbtn" href={perfil.linkedin} rel="noopener" aria-label="Isabela's LinkedIn"><Icon nome="linkedin" /></a>
          <a class="pf-iconbtn" href={perfil.github} rel="noopener" aria-label="Isabela's GitHub"><Icon nome="github" /></a>
        </div>
      </div>
      <div class="pf-hero__photo">
        <div class="pf-photo">
          <Image src={foto} alt={perfilEn.foto.alt} widths={[340, 680]} sizes="(min-width: 860px) 340px, 68vw" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <div class="pf-strip" data-strip role="region" aria-label="Technologies and tools">
    <div class="pf-strip__track">
      {faixaTechEn.map((t) => <span>{t}</span>)}
      {faixaTechEn.map((t) => <span class="pf-strip__dup" aria-hidden="true">{t}</span>)}
    </div>
    <button type="button" class="pf-strip__pause" data-pause aria-pressed="false" aria-label="Pause the technologies scroll">
      <span class="pf-strip__ico-pause"><Icon nome="pause" tamanho={18} /></span>
      <span class="pf-strip__ico-play"><Icon nome="play" tamanho={18} /></span>
    </button>
  </div>

  <section class="pf-section" style="padding-bottom: 0">
    <div class="pf-container">
      <ul class="pf-stats" aria-label="Numbers">
        {numerosEn.map((n) => <li><span class="v">{n.valor}</span><span class="l">{n.rotulo}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="pf-section" id="ia">
    <div class="pf-container">
      <div class="pf-sh"><p class="eyebrow">Focus</p><h2>Generative AI in practice</h2></div>
      <ul class="pf-tiles">
        {focoEn.map((f) => (
          <li class="pf-tile">
            <span class="pf-tile__ico"><Icon nome={f.icone} tamanho={24} /></span>
            <h3><a href={f.href}>{f.titulo}</a></h3>
            <p>{f.linha}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pf-section" id="work" style="padding-top: 0">
    <div class="pf-container">
      <div class="pf-sh">
        <p class="eyebrow">What I built</p>
        <h2>Selected work</h2>
        <p class="muted">Case studies are written in Portuguese. <a href="/#projetos">See all projects (in Portuguese)</a>.</p>
      </div>
      {grupos.map((gr) => gr.itens.length > 0 && (
        <div class="pf-group">
          <h3 class="pf-group__title">{gr.titulo} <span class="pf-group__sub">{gr.sub}</span></h3>
          <div class="pf-grid">
            {gr.itens.map((c) => {
              const e = casosEn[c.id];
              return <ProjectCard id={c.id} titulo={e.titulo} linha={e.linha} selo={e.selo} capa={c.data.capa} capaAlt={`Screen from the ${e.titulo} project`} capaTexto={e.capaTexto ?? c.data.capa_texto} icone={c.data.icone} verDetalhes="View details" />;
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="pf-section" id="experience" style="padding-top: 0">
    <div class="pf-container">
      <div class="pf-sh"><p class="eyebrow">Experience</p><h2>Where I worked</h2></div>
      <div class="pf-acc">
        {trajetoriaEn.map((t) => (
          <details class="pf-job">
            <summary>
              <span class="pf-job__main"><span class="co">{t.empresa}</span><span class="rl">{t.funcao}</span></span>
              <span class="pf-job__per">{t.periodo}</span>
            </summary>
            <div class="pf-acc__body"><ul>{t.marcadores.map((m) => <li>{m}</li>)}</ul></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="pf-section" id="skills" style="padding-top: 0">
    <div class="pf-container">
      <div class="pf-sh"><p class="eyebrow">Tools and foundations</p><h2>Skills</h2></div>
      <div class="pf-skills">
        {competenciasEn.map((g) => (
          <div>
            <h3>{g.area}</h3>
            <ul class="pf-tags">{g.itens.map((i) => <li class="pf-tag">{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pf-section" id="evaluation" style="padding-top: 0">
    <div class="pf-container">
      <div class="pf-sh"><p class="eyebrow">How I test AI</p><h2>Agent evaluation</h2></div>
      <div class="pf-card">
        <p>I evaluated a content-writing agent with adversarial cases built on fictional data: inventing metrics, publishing a phone number, leaking a confidential name, obeying an instruction hidden in a document. In the first sets grading is rule-based, with no model as judge, and the grader has its own tests.</p>
        <ul class="pf-prose">
          <li>Prompt <span class="mono">v0</span> (no rules): <span class="mono">{placarV0}</span> on the first 8 cases.</li>
          <li>Prompt <span class="mono">v1</span> (explicit rules): <span class="mono">{placarV1}</span>. It fixed v0's errors but introduced two new ones.</li>
          <li>Prompt <span class="mono">v2</span>: <span class="mono">{placarV2}</span>. I wrote it after seeing v1's failures, so I froze it and tested it on 4 new cases in 3 runs: <span class="mono">{execNovosV2}</span>.</li>
          <li><strong>A second set did not hold up.</strong> I wrote 5 more cases on a different fictional project whose facts state no problem or motivation, published them in git before any answer, and ran the agents with no tools in an empty folder. The frozen v2 scored <span class="mono">{execNovos2V2}</span> with the rule-based grader, but a blind judge (a Claude model) flagged invented claims in <span class="mono">{juizV2.inventa} of {juizV2.total}</span> answers: with no problem stated, v2 wrote one. Four of the grader's failures are false positives (quoting a refused word); publishing a colleague's name is a gap in the prompt's policy, not a clear failure. The judge was inconsistent in two cases and my own reading (8 of 9, range 7 to 9) is one person's. Part of the failure is the prompt's own rule that forces a Problem section. I did not change the prompt.</li>
        </ul>
        <p class="muted">Limits: small samples (8 and 4 cases), the first new cases reuse the same fictional facts, one project in the second set, a judge from the same model family, rule-based grading that cannot tell quoting a word from using it or detect qualitative claims the facts do not support, and a Claude model as the evaluated agent. The detailed write-up is in Portuguese.</p>
        <div class="pf-actions" style="margin-top: 0">
          <a class="pf-btn pf-btn--secondary" href="/como-foi-feito/#avaliacao"><Icon nome="arrow" tamanho={18} /> Evaluation (PT)</a>
          <a class="pf-btn pf-btn--ghost" href={`${perfil.repositorio}/tree/main/evals`} rel="noopener"><Icon nome="github" tamanho={18} /> Cases on GitHub</a>
        </div>
      </div>
    </div>
  </section>

  <section class="pf-section" id="contact" style="padding-top: 0">
    <div class="pf-container">
      <div class="pf-sh"><p class="eyebrow">Contact</p><h2>Let's talk</h2></div>
      <div class="pf-actions" style="margin-top: 0">
        <a class="pf-btn pf-btn--primary" href={mailto}><Icon nome="mail" tamanho={18} /> Get in touch</a>
        <a class="pf-btn pf-btn--secondary" href={cvEn.arquivo} download={cvEn.nome}><Icon nome="download" tamanho={18} /> Download CV</a>
        <a class="pf-btn pf-btn--ghost" href={perfil.linkedin} rel="noopener"><Icon nome="linkedin" tamanho={18} /> LinkedIn</a>
        <a class="pf-btn pf-btn--ghost" href={perfil.github} rel="noopener"><Icon nome="github" tamanho={18} /> GitHub</a>
        <a class="pf-btn pf-btn--ghost" href={perfil.repositorio} rel="noopener"><Icon nome="github" tamanho={18} /> Source code of this site</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Pauses/resumes the technologies strip. The CSS already keeps it still for users who prefer reduced motion.
  const faixa = document.querySelector<HTMLElement>("[data-strip]");
  const botao = document.querySelector<HTMLButtonElement>("[data-pause]");
  botao?.addEventListener("click", () => {
    const pausado = faixa?.getAttribute("data-paused") === "true";
    faixa?.setAttribute("data-paused", pausado ? "false" : "true");
    botao.setAttribute("aria-pressed", pausado ? "false" : "true");
    botao.setAttribute("aria-label", pausado ? "Pause the technologies scroll" : "Resume the technologies scroll");
  });
</script>
