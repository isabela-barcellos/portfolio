---
import Base from "../layouts/Base.astro";
import SectionHeader from "../components/SectionHeader.astro";
---
<Base titulo="Página não encontrada">
  <section class="pf-section">
    <div class="pf-container">
      <SectionHeader nivel="h1" eyebrow="Erro 404" titulo="Página não encontrada">
        <p class="lead">O endereço não existe ou foi movido.</p>
      </SectionHeader>
      <a class="pf-btn pf-btn--primary" href="/">Voltar ao início</a>
    </div>
  </section>
</Base>
