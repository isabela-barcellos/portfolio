---
// Carrossel de prints: faixa com rolagem por snap (funciona sem JS), botões e contador (JS opcional).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Slide { src: Promise<{ default: ImageMetadata }> | ImageMetadata; alt: string; legenda: string; href?: string }
interface Props { slides: Slide[]; rotulo: string; compacto?: boolean }
const { slides, rotulo, compacto = false } = Astro.props;
---
{slides.length > 0 && (
  <div class:list={["pf-car", compacto && "pf-car--compacto"]} data-carousel role="region" aria-roledescription="carrossel" aria-label={rotulo}>
    <ul class="pf-car__track" role="list" tabindex="0" aria-label={`${rotulo}: use as setas para navegar`} data-track>
      {slides.map((s, i) => (
        <li class="pf-car__slide" aria-roledescription="slide" aria-label={`${i + 1} de ${slides.length}`}>
          <figure>
            <div class="pf-car__frame">
              <Image src={s.src as any} alt={s.alt} widths={[240, 390, 560, 800]} sizes="(min-width: 1024px) 240px, (min-width: 640px) 33vw, 70vw" loading={i < 2 ? "eager" : "lazy"} />
            </div>
            <figcaption>{s.href ? <a href={s.href}>{s.legenda}</a> : s.legenda}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
    {slides.length > 1 && (
      <div class="pf-car__ctrl">
        <button type="button" class="pf-car__btn" data-prev aria-label="Slide anterior"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg></button>
        <span class="pf-car__count mono" data-count aria-live="polite">1 / {slides.length}</span>
        <button type="button" class="pf-car__btn" data-next aria-label="Próximo slide"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg></button>
      </div>
    )}
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-track]");
    if (!track) return;
    const slides = [...track.children] as HTMLElement[];
    const count = root.querySelector<HTMLElement>("[data-count]");
    const passo = () => (slides[1] ? slides[1].offsetLeft - slides[0].offsetLeft : track.clientWidth);
    const atual = () => Math.min(slides.length - 1, Math.round(track.scrollLeft / Math.max(1, passo())));
    const atualizar = () => { if (count) count.textContent = `${atual() + 1} / ${slides.length}`; };
    const reduz = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ir = (d: number) => track.scrollBy({ left: d * passo(), behavior: reduz ? "auto" : "smooth" });
    root.querySelector("[data-prev]")?.addEventListener("click", () => ir(-1));
    root.querySelector("[data-next]")?.addEventListener("click", () => ir(1));
    track.addEventListener("scroll", () => requestAnimationFrame(atualizar), { passive: true });
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); ir(1); }
      if (e.key === "ArrowLeft") { e.preventDefault(); ir(-1); }
    });
  });
</script>
